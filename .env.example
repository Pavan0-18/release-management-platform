# ==========================================
# Release Management Platform Environment Configuration
# ==========================================

# Node Environment: development | test | production
NODE_ENV=development

# ------------------------------------------
# Backend API Configuration
# ------------------------------------------
PORT=3000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database Connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/release_management?schema=public

# Docker compose database configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=release_management
POSTGRES_PORT=5432

# GraphQL Endpoint Configuration
GRAPHQL_PATH=/graphql
GRAPHQL_PLAYGROUND=true

# ------------------------------------------
# Frontend Web Configuration
# ------------------------------------------
VITE_API_URL=http://localhost:3000/graphql
VITE_APP_TITLE="Release Management Platform"
