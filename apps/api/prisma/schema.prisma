generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// System health check & connection verification
model HealthCheck {
  id        String   @id @default(uuid())
  status    String   @default("HEALTHY")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("health_checks")
}

// Project Entity (Scoping releases and default checklists)
model Project {
  id               String        @id @default(uuid())
  name             String
  key              String        @unique
  description      String?
  nature           ProjectNature @default(MONOLITH)
  services         Json?         // Array of service names string[] for microservices
  defaultChecklist Json?         // Array of default checklist templates [{ title: string, description?: string, isRequired: boolean }]
  releases         Release[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("projects")
}

// Core Release Entity scoped to Project & optional Service
model Release {
  id          String        @id @default(uuid())
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  serviceName String?       // Specific service for MICROSERVICES projects (null for MONOLITH)
  name        String
  version     String
  description String?
  status      ReleaseStatus @default(DRAFT)
  targetDate  DateTime?
  steps       ReleaseStep[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([projectId, serviceName, version])
  @@index([projectId])
  @@index([projectId, serviceName])
  @@map("releases")
}

// Release Checklist Step
model ReleaseStep {
  id          String     @id @default(uuid())
  releaseId   String
  release     Release    @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      StepStatus @default(PENDING)
  order       Int        @default(0)
  isRequired  Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([releaseId])
  @@map("release_steps")
}

enum ProjectNature {
  MONOLITH
  MICROSERVICES
}

enum ReleaseStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  READY_FOR_DEPLOYMENT
  DEPLOYED
  CANCELLED
  FAILED
}

enum StepStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
  SKIPPED
}
